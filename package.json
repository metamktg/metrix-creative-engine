{
  "name": "metrix-creative-engine",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server and Claude Code skills for generating ad creative through Kie.ai",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "bin": {
    "kie-ai-mcp-server": "./dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node ./build.mjs",
    "start": "node ./dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "verify": "npm run check:copies && npm run check:production-standard && npm run typecheck && npm run test && npm run build && npm run check:mcp-surface && npm run test:production-review && npm run test:retention && npm run test:client-library",
    "check:copies": "node ./scripts/sync-copies.mjs --check",
    "sync:copies": "node ./scripts/sync-copies.mjs",
    "check:production-standard": "python -B skills/ugc-creator-edit/scripts/build_standard_doc.py --check --out docs/UGC_PRODUCTION_STANDARD.md",
    "check:mcp-surface": "node ./scripts/check-mcp-surface.mjs",
    "check:production-review": "python scripts/validate_review_gates.py",
    "test:retention": "python -B -m unittest discover -s scripts -p test_retain_drafts.py -q",
    "test:production-review": "python -B -m unittest discover -s scripts -p test_*review*.py -q",
    "test:client-library": "python -B -m unittest discover -s scripts -p test_client_library.py -q",
    "tools:check": "node ./scripts/tools-check.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.21.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.27.3",
    "hyperframes": "0.9.19",
    "typescript": "~5.9.3",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
