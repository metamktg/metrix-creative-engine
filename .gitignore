node_modules/
dist/
*.tsbuildinfo
.vitest-downloads/

# Generated creative. Assets are large and regenerable; keep them out of git
# and let KIE_AI_DOWNLOAD_DIR point wherever you actually want them.
out/
renders/

# Never commit a key. The .example template is the exception and must ship,
# otherwise nobody knows which variables exist.
.env
.env.*
!.env.example

# Built brand kits: the JSON and PROMPTS.md are the source of truth, and an
# inlined kit runs past 3MB of base64 that git cannot diff. Rebuild, do not store.
brand-kits/**/*.source.html
brand-kits/**/*.pdf
