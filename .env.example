# Copy to .env and fill in. .env is gitignored; never commit a real key.
# Create a key at https://kie.ai/api-key
KIE_AI_API_KEY=

# Optional. Enables the kie_download_result tool and fixes where it writes.
KIE_AI_DOWNLOAD_DIR=./out

# Optional. The task ledger: one append-only JSONL line per create and settle.
# Kie's result URLs expire in about 24 hours; the taskId does not, and re-polling
# it re-issues a URL, so this file is what makes an overnight batch recoverable.
# Defaults ON, at <KIE_AI_DOWNLOAD_DIR or ./out>/kie-ledger.jsonl. Set to "off"
# to disable. Read it with `node kie.mjs ledger` or the kie_ledger tool.
KIE_AI_LEDGER_PATH=

# Optional. Default timeout for the waiting tools, in seconds.
KIE_AI_DEFAULT_WAIT_SECONDS=300

# Optional. Per-HTTP-request timeout, in milliseconds.
KIE_AI_REQUEST_TIMEOUT_MS=60000
