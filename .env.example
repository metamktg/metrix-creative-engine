# Copy to .env and fill in. .env is gitignored; never commit a real key.
# Create a key at https://kie.ai/api-key
KIE_AI_API_KEY=

# Optional. Enables the kie_download_result tool and fixes where it writes.
KIE_AI_DOWNLOAD_DIR=./out

# Optional. Default timeout for the waiting tools, in seconds.
KIE_AI_DEFAULT_WAIT_SECONDS=300

# Optional. Per-HTTP-request timeout, in milliseconds.
KIE_AI_REQUEST_TIMEOUT_MS=60000
